# Copy to .env and adjust. Every setting the app reads is listed here.

# --- Ports (host side) ---
BACKEND_PORT=8010
FRONTEND_PORT=5173
POSTGRES_PORT=5433

# --- Database (local Docker Postgres) ---
POSTGRES_USER=ratemyclass
POSTGRES_PASSWORD=ratemyclass
POSTGRES_DB=ratemyclass
DATABASE_URL=postgresql+psycopg://ratemyclass:ratemyclass@localhost:5433/ratemyclass

# --- App ---
# local | test | production
APP_ENV=local
